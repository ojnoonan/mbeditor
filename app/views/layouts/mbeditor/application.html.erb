<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="turbo-visit-control" content="reload" />
  <meta name="theme-color" content="#1e1e2e" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <% pwa_base = mbeditor_base_path %>
  <link rel="manifest" href="<%= "#{pwa_base}/manifest.webmanifest" %>" />
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('<%= json_escape("#{pwa_base}/sw.js") %>', { scope: '<%= json_escape("#{pwa_base}/") %>' });
    }
  </script>
  <title>Mbeditor — <%= Rails.root.basename %></title>

  <!-- ── Fonts and Styles ──────────────────────────────── -->
  <%= stylesheet_link_tag "fontawesome.min", media: "all", preload_links_header: false %>
  <%= stylesheet_link_tag "mbeditor/application", media: "all", preload_links_header: false %>

  <!-- ── ActionCable (deferred — sets window.ActionCable for WebSocket service) ── -->
  <% if defined?(ActionCable::Channel::Base) %>
  <script defer src="<%= asset_path('actioncable.js') %>"></script>
  <% end %>
  <!-- ── Vendor JS (deferred — only needed inside Monaco callback) ── -->
  <script defer src="<%= asset_path('react.min.js') %>"></script>
  <script defer src="<%= asset_path('react-dom.min.js') %>"></script>
  <script defer src="<%= asset_path('axios.min.js') %>"></script>
  <script defer src="<%= asset_path('lodash.min.js') %>"></script>
  <!-- Yjs + y-monaco + y-protocols (awareness) — maintainer-prebuilt bundle for collaborative editing; exposes window.Y / window.MonacoBinding / window.awarenessProtocol -->
  <script defer src="<%= asset_path('yjs-collab.js') %>"></script>
  <script defer src="<%= asset_path('minisearch.min.js') %>"></script>
  <script defer src="<%= asset_path('marked.min.js') %>"></script>
  <!-- ── Monaco (ESM bundle, ADR 0002): stylesheet here, JS loaded in body ── -->
  <% base_path = pwa_base %>
  <link rel="stylesheet" href="<%= "#{base_path}/monaco-editor/monaco.css" %>" media="all" />
  <!-- ── Emmet + Extra themes (non-AMD, deferred — used inside Monaco callback) ── -->
  <script defer src="<%= asset_path('emmet.js') %>"></script>
  <script defer src="<%= asset_path('monaco-themes-bundle.js') %>"></script>
</head>
<body data-rails-root="<%= Rails.root.to_s %>" data-mbeditor-version="<%= Mbeditor::VERSION %>">
  <script><%== Mbeditor::EditorBootstrap.setup_js(base_path) %></script>

  <div id="mbeditor-root">
    <div id="mbeditor-loading">
      <div class="mbeditor-spinner"></div>
      <div class="mbeditor-loading-text">Loading editor&hellip;</div>
    </div>
    <%= yield %>
  </div>

  <%# Bootstrap JS shared with the pending-migrations fallback shell — see Mbeditor::EditorBootstrap %>
  <script><%== Mbeditor::EditorBootstrap.boot_js(
    base: base_path,
    prettier_script_urls: [
      asset_path("prettier-standalone.js"),
      asset_path("prettier-plugin-babel.js"),
      asset_path("prettier-plugin-estree.js"),
      asset_path("prettier-plugin-html.js"),
      asset_path("prettier-plugin-postcss.js"),
      asset_path("prettier-plugin-markdown.js")
    ],
    application_js_url: asset_path("mbeditor/application.js")
  ) %></script>
</body>
</html>
